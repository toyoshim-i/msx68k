* Control Manager (CM) APIs ($A289..$A2A7)
* -----------------------------------------------------------------------------
CMNewControl		.equ	$A289
CMDisposeControl	.equ	$A28A
CMSetCtlValue		.equ	$A28E
CMGetCtlValue		.equ	$A28F

* -----------------------------------------------------------------------------
* Dialog Manager (DLM) APIs ($A2C0..$A2FA)
* -----------------------------------------------------------------------------
DMGetNewDialog		.equ	$A2C0
DMModalDialog		.equ	$A2C2
DMIsDialogEvent		.equ	$A2C3
DMDialogSelect		.equ	$A2C4
DMAlert			.equ	$A2CA
DMStopAlert		.equ	$A2CB
DMNoteAlert		.equ	$A2CC
DMCautionAlert		.equ	$A2CD

* -----------------------------------------------------------------------------
* Screen & SRAM Management ($A42E..$A437)
* -----------------------------------------------------------------------------
SCA_TextScroll		.equ	$A42E	; Hardware CRTC text scroll
SCA_GetScroll		.equ	$A42F	; Get current text scroll offsets
SCA_SetCrtMode		.equ	$A430	; Set physical CRT mode in SRAM ($ED007E)
SCA_GetCrtMode		.equ	$A431	; Get physical CRT mode from SRAM
SCA_GetCrtTable		.equ	$A432	; Get physical CRT resolution table
SCA_SetScrnMode		.equ	$A436	; Set virtual screen mode in SRAM ($ED007C)
SCA_GetScrnMode		.equ	$A437	; Get virtual screen mode from SRAM

* -----------------------------------------------------------------------------
* Data Structure Offsets & Equates
* -----------------------------------------------------------------------------

* Rect Record (8 bytes)
rect_top		.equ	0
rect_left		.equ	2
rect_bottom		.equ	4
rect_right		.equ	6
rect_size		.equ	8

* Point Record (4 bytes)
pt_v			.equ	0
pt_h			.equ	2
pt_size			.equ	4

* GrafPort Record (108 bytes)
gp_device		.equ	0
gp_portBits		.equ	2
gp_portRect		.equ	4
gp_visRgn		.equ	12
gp_clipRgn		.equ	16
gp_foreColor		.equ	20
gp_backColor		.equ	22
gp_txFont		.equ	24
gp_txFace		.equ	26
gp_txMode		.equ	28
gp_txSize		.equ	30
gp_spExtra		.equ	32
gp_pnLoc		.equ	36
gp_pnSize		.equ	40
gp_pnMode		.equ	44
gp_pnPat		.equ	46
gp_fillPat		.equ	54
gp_pnVis		.equ	62

* BitMap Record (22 bytes)
bm_baseAddr		.equ	0
bm_rowBytes		.equ	4
bm_bounds		.equ	6
bm_planes		.equ	14
bm_size			.equ	22

* MouseWorkArea Offsets (pointed by text_base + $633CA)
mwa_curX		.equ	10
mwa_curY		.equ	12
mwa_boundTop		.equ	52
mwa_boundLeft		.equ	54
mwa_boundBottom		.equ	56
mwa_boundRight		.equ	58
