* -----------------------------------------------------------------------------
* SX-Window v3.1 A-Line ($Axxx) API Equates
* Clean-room specification aligned with official Sharp SX-Window Workroom SDK
* -----------------------------------------------------------------------------

SXCALL	.macro	trap
	.dc.w	&trap
	.endm

* -----------------------------------------------------------------------------
* Memory Manager (MM) APIs ($A000..$A055)
* -----------------------------------------------------------------------------
MMAllocPtr		.equ	$A01E
MMDisposePtr		.equ	$A020
MMAllocHandle		.equ	$A022
MMDisposeHandle		.equ	$A024
MMSetHandleSize		.equ	$A026
MMGetHandleSize		.equ	$A028
MMLockHandle		.equ	$A02A
MMUnlockHandle		.equ	$A02C
MMHdlDispose		.equ	$A038	; Dispose of a handle (handle)

* -----------------------------------------------------------------------------
* Mouse Manager (MSM) APIs ($A06A..$A078)
* -----------------------------------------------------------------------------
MSShow			.equ	$A06A
MSHide			.equ	$A06B
MSCurSpeed		.equ	$A072
MSBoundSet		.equ	$A077
MSMove			.equ	$A078

* -----------------------------------------------------------------------------
* Event & Task Manager (TS) APIs ($A34C..$A4C0)
* Official Sharp Workroom SX-68K names & common aliases
* -----------------------------------------------------------------------------
TSInitTsk		.equ	$A34C
TSInitCrtM		.equ	$A34E
TSTiniCrtM		.equ	$A34F
TSInitApp		.equ	$A350	; Initialize application task (clears 6KB work area)
AppInit			.equ	$A350	; Compatibility alias
TSExit			.equ	$A352	; Terminate application task
AppExit			.equ	$A352	; Compatibility alias
TSEventAvail		.equ	$A357	; Query next pending event from queue
EMGetNextEvent		.equ	$A357	; Compatibility alias
TSGetEvent		.equ	$A358	; Yield and retrieve event (EMPostYield)
EMPostYield		.equ	$A358	; Compatibility alias
TSPostEventTsk		.equ	$A35A
TSGetTdb		.equ	$A35B	; Copy a task's record (buffer of 512 bytes, task ID.w, -1 for this one)
TSGetID			.equ	$A360	; Get current task / app RefCon
TSResNew		.equ	$A4A0	; Create an empty resource map for the task's resource chain
TSResOpen		.equ	$A4A1	; Open a resource file for the task (name ptr) -> A0 map
TSResClose		.equ	$A4A2	; Save the current resource map to a file and close it (name ptr)
TSResRemove		.equ	$A4A4	; Remove the current resource map without saving it, closing its file
TSResLoad		.equ	$A4A5	; Load all of the current resource map's resources, closing its file
TSRscAdd		.equ	$A4AA	; Add a resource (type, id.w, handle, size)
TSRscGet		.equ	$A4AB	; Find a resource (type, id.w) -> A0 handle
TSRscRemove		.equ	$A4AC	; Remove a resource (type, id.w)
GetAppRefCon		.equ	$A360	; Compatibility alias
SXCallWindM		.equ	$A3A2	; Window drag, close-box & content event processor
WDoEvent		.equ	$A3A2	; Compatibility alias
EMEventAvail		.equ	$A0A3
EMFlushEvents		.equ	$A0A4

