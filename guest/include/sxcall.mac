GMGetGraph		.equ	$A132
GMGetPort		.equ	$A132	; Compatibility alias
GMCopyGraph		.equ	$A133
GMMoveGraph		.equ	$A136
GMSlideGraph		.equ	$A137
GMClipRect		.equ	$A13A
GMSetGraphSize		.equ	$A13C
GMInitBitmap		.equ	$A13C
GMLocalToGlobal		.equ	$A13E
GMGlobalToLocal		.equ	$A13F	; Point by value (4B), returns [y:w, x:w] in D0
GMPenMode		.equ	$A144	; Set pen transfer mode (int)
GMForeColor		.equ	$A147	; Set foreground color (int)
GMBackColor		.equ	$A148	; Set background color (int)
GMAPage			.equ	$A149	; Set the text planes drawing reaches (mask.w) -> D0.W the previous
GMNullRect		.equ	$A14E
GMSizeRect		.equ	$A14F
GMAndRects		.equ	$A150
GMMoveRect		.equ	$A151
GMSlideRect		.equ	$A152
GMInsetRect		.equ	$A153
GMPtInRect		.equ	$A156
GMEqualRect		.equ	$A157
GMEmptyRect		.equ	$A158
GMMove			.equ	$A16E	; Move pen to LPoint (x << 16 | y)
GMMoveTo		.equ	$A16E	; Compatibility alias
GMMoveRel		.equ	$A16F
GMLine			.equ	$A170
GMLineRel		.equ	$A171
GMFrameRect		.equ	$A172	; Draw rectangle outline (Rect *)
GMFillRect		.equ	$A173	; Fill rectangle with current pattern (Rect *)
GMEraseRect		.equ	$A173	; Compatibility alias
GMFrameOval		.equ	$A174	; Draw ellipse outline (Rect *)
GMFillOval		.equ	$A175	; Fill ellipse (Rect *)
GMFrameRRect		.equ	$A176	; Draw rounded rectangle outline
GMFillRRect		.equ	$A177	; Fill rounded rectangle
GMFrameArc		.equ	$A178
GMFillArc		.equ	$A179
GMFrameRgn		.equ	$A17A
GMFillRgn		.equ	$A17B
GMFramePoly		.equ	$A17C
GMFillPoly		.equ	$A17D
GMScroll		.equ	$A17E
GMCopy			.equ	$A17F
GMCopyMask		.equ	$A180
GMFontKind		.equ	$A18B	; Set text font kind
GMSetTxFont		.equ	$A18B	; Compatibility alias
GMFontFace		.equ	$A18C	; Set text font face
GMSetTxFace		.equ	$A18C	; Compatibility alias
GMFontMode		.equ	$A18D	; Set text transfer mode
GMFontSize		.equ	$A18E	; Set text size (w: int16, h: int16)
GMSetTxSize		.equ	$A18E	; Compatibility alias
GMDrawChar		.equ	$A18F	; Draw single character
GMDrawStrL		.equ	$A190	; Draw Pascal string (length byte + ASCII, 4B ptr)
GMDrawString		.equ	$A190	; Compatibility alias
GMDrawStr		.equ	$A191	; Draw string slice (ptr, offset, count)
GMDrawText		.equ	$A191	; Compatibility alias
GMDrawStrZ		.equ	$A192	; Draw null-terminated C-string (4B ptr)
GMCharWidth		.equ	$A194
GMStrLWidth		.equ	$A195
GMStrWidth		.equ	$A196
GMStrLength		.equ	$A197
GMFontInfo		.equ	$A198
GMShadowStrZ		.equ	$A1A1
GMShadowRect		.equ	$A1A2
GMInvertRect		.equ	$A1A3	; Invert rectangle bits (Rect *, int mode: 6B on stack)
GMPlotImg		.equ	$A182	; Draw a plot image into a rect (image ptr, Rect *, mode.w)
GMCenterRect		.equ	$A1D6

* -----------------------------------------------------------------------------
* Window Manager (WM) APIs ($A1F8..$A22E)
* Official Sharp Workroom SX-68K names & common aliases
* -----------------------------------------------------------------------------
WMInit			.equ	$A1F8
WMNewWindow		.equ	$A1F8
WMOpen			.equ	$A1F9	; Open document window (26B stack args, returns A0 Window *)
WMRefer			.equ	$A1FA
WMClose			.equ	$A1FB
WMDispose		.equ	$A1FC	; Close & dispose window (Window *)
WMCloseWindow		.equ	$A1FC	; Compatibility alias
WMDisposeWindow		.equ	$A1FC	; Compatibility alias
WMFind			.equ	$A1FD	; Find clicked window
WMFindWindow		.equ	$A1FD	; Compatibility alias
WMSelect		.equ	$A1FE	; Bring window to front & activate
WMBringToFront		.equ	$A1FE	; Compatibility alias
WMSelectWindow		.equ	$A1FE	; Compatibility alias
WMCarry			.equ	$A200
WMMove			.equ	$A202
WMSize			.equ	$A203	; Size a window's content (win, LPoint size, fUpdate.w)
WMDrag			.equ	$A205
WMDragWindow		.equ	$A205	; Compatibility alias
WMShow			.equ	$A207	; Show window (Window *)
WMHide			.equ	$A208	; Hide window (Window *)
WMTrackGoAway		.equ	$A20A	; Compatibility alias
WMUpdate		.equ	$A20D	; Begin window update
WMBeginUpdate		.equ	$A20D	; Compatibility alias
WMUpdtOver		.equ	$A20E	; End window update
WMEndUpdate		.equ	$A20E	; Compatibility alias
WMGetDTGS		.equ	$A224	; Get desktop GrafPort

* -----------------------------------------------------------------------------
* Sub-Window Manager (SWM) APIs ($A227..$A22B)
* -----------------------------------------------------------------------------
WSOpen			.equ	$A227
WSClose			.equ	$A228
WSDispose		.equ	$A229
WSSelect		.equ	$A22A
WSUpdate		.equ	$A22B

* -----------------------------------------------------------------------------
* Menu Man (MN) APIs ($A266..$A26C)
* -----------------------------------------------------------------------------
MNSelect		.equ	$A268	; Pop up a menu (handle, global LPoint) -> D0 submenu ID.w : item.w
MNConvert2		.equ	$A26B	; Build a menu record from a string (handle or 0, str, ID.w) -> A0

* -----------------------------------------------------------------------------
* Control Manager (CM) APIs ($A289..$A2A7)
* -----------------------------------------------------------------------------
CMNewControl		.equ	$A289
CMDisposeControl	.equ	$A28A
CMSetCtlValue		.equ	$A28E
CMGetCtlValue		.equ	$A28F

* -----------------------------------------------------------------------------
* Dialog Manager (DLM) APIs ($A2C0..$A2FA)
* -----------------------------------------------------------------------------
DMGetNewDialog		.equ	$A2C0
DMModalDialog		.equ	$A2C2
DMIsDialogEvent		.equ	$A2C3
DMDialogSelect		.equ	$A2C4
DMAlert			.equ	$A2CA
DMStopAlert		.equ	$A2CB
DMNoteAlert		.equ	$A2CC
DMCautionAlert		.equ	$A2CD
* Sharp's names (Workroom SX-68K)
DMRefer			.equ	$A2C4	; Make a dialog from 'DLOG' (id.w, record or 0, behind) -> A0
DMDispose		.equ	$A2C6	; Close and dispose of a dialog made on the heap
DMClose			.equ	$A2C5	; Close a dialog whose record is not on the heap
DMControl		.equ	$A2C7	; Run the current dialog until an item returns (filter) -> D0
DMDraw			.equ	$A2C8	; Draw all of a dialog's items
DIGet			.equ	$A2CF	; An item's type, handle, and rectangle (dlg, no.w, 3 buffers)
DITSet			.equ	$A2D2	; Set an item's text (type.w, handle, Pascal string)
DITGet			.equ	$A2D1	; Get an item's text (type.w, handle, buffer)
DIHide			.equ	$A2D8	; Hide an item (dlg, no.w)
DIShow			.equ	$A2D9	; Show an item again (dlg, no.w)
CMShine			.equ	$A298	; Highlight a control's part (handle, part.w): 255 inactive
TMIdle			.equ	$A30E	; Blink a text edit's cursor (handle)
DMError			.equ	$A2F6	; An alert (flags.w, ASCIIZ) -> D0 the button
CMValueSet		.equ	$A290	; Set a control's value (handle, value.w)
CMValueGet		.equ	$A291	; A control's value (handle) -> D0

* -----------------------------------------------------------------------------
* Screen & SRAM Management ($A42E..$A437)
* -----------------------------------------------------------------------------
SCA_TextScroll		.equ	$A42E	; Hardware CRTC text scroll
SCA_GetScroll		.equ	$A42F	; Get current text scroll offsets
SCA_SetCrtMode		.equ	$A430	; Set physical CRT mode in SRAM ($ED007E)
SCA_GetCrtMode		.equ	$A431	; Get physical CRT mode from SRAM
SCA_GetCrtTable		.equ	$A432	; Get physical CRT resolution table
SCA_SetScrnMode		.equ	$A436	; Set virtual screen mode in SRAM ($ED007C)
SCA_GetScrnMode		.equ	$A437	; Get virtual screen mode from SRAM

* -----------------------------------------------------------------------------
* Data Structure Offsets & Equates
* -----------------------------------------------------------------------------

* Rect Record (8 bytes)
rect_top		.equ	0
rect_left		.equ	2
rect_bottom		.equ	4
rect_right		.equ	6
rect_size		.equ	8

* Point Record (4 bytes)
pt_v			.equ	0
pt_h			.equ	2
pt_size			.equ	4

* GrafPort Record (108 bytes)
gp_device		.equ	0
gp_portBits		.equ	2
gp_portRect		.equ	4
gp_visRgn		.equ	12
gp_clipRgn		.equ	16
gp_foreColor		.equ	20
gp_backColor		.equ	22
gp_txFont		.equ	24
gp_txFace		.equ	26
gp_txMode		.equ	28
gp_txSize		.equ	30
gp_spExtra		.equ	32
gp_pnLoc		.equ	36
gp_pnSize		.equ	40
gp_pnMode		.equ	44
gp_pnPat		.equ	46
gp_fillPat		.equ	54
gp_pnVis		.equ	62

* BitMap Record (22 bytes)
bm_baseAddr		.equ	0
bm_rowBytes		.equ	4
bm_bounds		.equ	6
bm_planes		.equ	14
bm_size			.equ	22

* MouseWorkArea Offsets (pointed by text_base + $633CA)
mwa_curX		.equ	10
mwa_curY		.equ	12
mwa_boundTop		.equ	52
mwa_boundLeft		.equ	54
mwa_boundBottom		.equ	56
mwa_boundRight		.equ	58
