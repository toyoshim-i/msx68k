* -----------------------------------------------------------------------------
* msx68k Application Entry Interface & Equates
* The entry sits at the end of the internal SCSI ROM window; its values must match
* crates/msx68k-bus/src/hypercall.rs, which a test checks
* -----------------------------------------------------------------------------

MSX68K_ENTRY_BASE	.equ	$FDFFF0	; 'MSX68K' + version.w
MSX68K_ENTRY		.equ	$FDFFF8	; JSR here with the function in D0.L
MSX68K_VERSION		.equ	1	; Lowest version this interface needs

* Application functions (D0.L)
MSX68K_FN_VERSION	.equ	0	; Returns the version in D0.L
MSX68K_FN_GET_WHEEL	.equ	1	; Returns D1 reverse, D2 clicks, D3 trackpad pixels
MSX68K_FN_SET_WHEEL	.equ	2	; Sets D1-D3 and returns them as clamped
MSX68K_FN_SCREEN_MODE	.equ	3	; D1.L = -1 queries, otherwise switches the resolution
MSX68K_FN_VM_OPEN	.equ	4	; D1.L = WindowPtr, D2.L = drive 0 image size, D3.L = drives, D4.W = screen's top,
				; D5.L = 16 KB SRAM or 0, D6.L = speed, D7.L = CPU << 16 | RAM MB
				; (CPU 0 68000, 1 68030); returns the VM ID
MSX68K_FN_VM_POLL	.equ	5	; D1.L = VM ID, D2.L/D3.L = buffer/size; returns a disk request
MSX68K_FN_VM_CLOSE	.equ	6	; D1.L = VM ID; stops the VM
MSX68K_FN_VM_REPLY	.equ	7	; D1.L = VM ID, D2.L = 0 when the request succeeded
MSX68K_FN_VM_SPEED	.equ	8	; D1.L = VM ID, D2.L = speed: 68000 0 10 MHz, 1 16 MHz, 2 24 MHz, 3 Burst;
				; 68030 0 25 MHz, 1 Burst
MSX68K_FN_VM_STATUS	.equ	9	; D1.L = VM ID; returns D0 bit 0 = lamp lit, bit 1 = SRAM to save,
				; bit 2 = redraw the window, D1.L = width << 16 | height
				; D2 bits 0..3 connected FDs, 4..7 inserted, 8..11 lamps, 12..15 passthrough
				; D2 = 0 in shared mode; D3 = Boot menu choice
MSX68K_FN_VM_SRAM	.equ	10	; D1.L = VM ID, D2.L/D3.L = buffer/size; returns the SRAM's size
MSX68K_FN_VM_RESTART	.equ	11	; D1.L = VM ID, D2.L = CPU << 16 | RAM MB, D3.L = speed

MSX68K_FN_VM_MEDIA	.equ	12	; D1 VM, D2 unit, D3 handle (-1 eject), D4 image length
MSX68K_FN_VM_BOOT	.equ	13	; D1 VM, D2 menu choice (0..13), A1 ROM address
				; D2=-1 queries; D1=0 creates SRAM at A0, with RAM MB in D3

MSX68K_FN_VM_IMAGE	.equ	14	; D1 DOS handle, D2 file length, D3 chunk length (0 starts probing), A0 chunk
				; returns D0 0 other, 1 floppy, 2 read D1 bytes at offset D2
MSX68K_FN_VM_VIRUS	.equ	16	; D1 action (0 detect, 1 repair forceboot, 2 repair clean IPL)
MSX68K_FN_VM_RESET	.equ	17	; D1.L = VM ID; resets the VM
MSX68K_FN_VM_INTERRUPT	.equ	18	; D1.L = VM ID; triggers a level-7 NMI on the VM
MSX68K_FN_VM_JOYPAD	.equ	19	; D1.L = VM ID, D2.L = enabled (0/1), A0.L = 6 scancodes
MSX68K_FN_VM_VSYNC	.equ	20	; D1.L = VM ID, D2.L = enabled (0/1)

* Expands msx68k_call (needs doscall.mac): calls function D0.L of the msx68k entry with D1-D3
* in supervisor mode, through DOS _SUPER_JSR, and returns its D0-D3, or D0.L = -1 when the
* entry is not there. The entry is looked for with _BUS_ERR, so it is safe on machines without
* one.
MSX68K_CALL_ROUTINE .macro
msx68k_call:
	movem.l	a1, -(sp)
	movem.l	d0-d3, -(sp)		; Arguments
	subq.l	#8, sp			; Signature buffer
	movea.l	sp, a1
	move.w	#4, -(sp)
	pea	(a1)
	pea	MSX68K_ENTRY_BASE
	DOS	_BUS_ERR
	lea	10(sp), sp
	tst.l	d0
	bne.s	msx68k_call_absent
	move.w	#4, -(sp)
	pea	4(a1)
	pea	MSX68K_ENTRY_BASE+4
	DOS	_BUS_ERR
	lea	10(sp), sp
	tst.l	d0
	bne.s	msx68k_call_absent
	cmpi.l	#'MSX6', (a1)
	bne.s	msx68k_call_absent
	cmpi.w	#'8K', 4(a1)
	bne.s	msx68k_call_absent
	cmpi.w	#MSX68K_VERSION, 6(a1)
	bcs.s	msx68k_call_absent
	addq.l	#8, sp

	* The ROM window is reachable only in supervisor mode, which _SUPER_JSR runs the entry in
	movem.l	(sp)+, d0-d3
	movea.l	(sp), a1		; restore the caller's A1 argument after probing
	pea	MSX68K_ENTRY
	DOS	_SUPER_JSR
	addq.l	#4, sp
	bra.s	msx68k_call_done

msx68k_call_absent:
	addq.l	#8, sp
	movem.l	(sp)+, d0-d3
	moveq.l	#-1, d0
msx68k_call_done:
	movem.l	(sp)+, a1
	rts
	.endm

MSX68K_FN_VM_SPRITE_OPTIONS .equ 15 ; D1 VM, D2 flags (bit0 unlimited, bit1 full RAM), -1 query
